# Bulk API
BULK_API_URL=https://exchange-api.bulk.trade/api/v1
BULK_PRIVATE_KEY=
BULK_ACCOUNT=
BULK_SIGNER=

# Live switch: default safe dry-run
ENABLE_LIVE_TRADING=false
DRY_RUN=true

# Perpetual leverage config. Keep 0 to skip leverage updates.
TARGET_LEVERAGE=5
APPLY_LEVERAGE_ON_START=false
USE_ISOLATED=false

# Symbols
# Leave MANUAL_SYMBOLS empty to use auto-discovery fallback probe + cache.
# If discovery misses pairs, add them here.
MANUAL_SYMBOLS=
AUTO_DISCOVER_SYMBOLS=true
SYMBOL_CACHE_PATH=data/symbols_cache.json
REFRESH_SYMBOLS_EACH_START=false
# Optional: override candidate universe. Empty = built-in candidate list.
DISCOVERY_CANDIDATES=BTC-USD,ETH-USD,SOL-USD,XRP-USD,DOGE-USD,BNB-USD,SUI-USD,HYPE-USD,ADA-USD,AVAX-USD,LINK-USD,LTC-USD,BCH-USD,TON-USD,TRX-USD,DOT-USD,APT-USD,ARB-USD,OP-USD,SEI-USD,INJ-USD,NEAR-USD,WIF-USD,PEPE-USD
STATIC_FALLBACK_SYMBOLS=BTC-USD,ETH-USD,SOL-USD,XRP-USD,DOGE-USD,BNB-USD,SUI-USD
USE_STATIC_FALLBACK_SYMBOLS=true

# Aggressive strategy
SCAN_INTERVAL_SECONDS=20
TOP_N_SYMBOLS=5
MIN_SIGNAL_SCORE=0.45
MIN_CANDLES=30
MAX_SPREAD_PCT=0.005

# Aggressive sizing
ASSUMED_EQUITY=100
BASE_EQUITY_FRACTION=0.15
STRONG_EQUITY_FRACTION=0.25
EXTREME_EQUITY_FRACTION=0.40

# Realized ROI exits
TAKE_PROFIT_PCT=0.0015
STOP_LOSS_PCT=0.0010
TIMEOUT_SECONDS=60
ORDER_COOLDOWN_SECONDS=15
ALLOW_PYRAMIDING_SAME_SYMBOL=false
CLOSE_ON_SIGNAL_REVERSAL=true

# Telegram cockpit
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_PRETTY=true
TELEGRAM_SCAN_SUMMARY=false
TELEGRAM_SUMMARY_EVERY_SCANS=20
